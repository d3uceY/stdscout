<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="stdscout.exe"
        Arguments=""
        InstallLocation="C:\Program Files\d3uceY\StdScout">
    </Installer>
    <PackageInformation
        PackageName="StdScout"
        PackageDisplayName="StdScout"
        PublisherName="CN=d3uceY"
        PublisherDisplayName="d3uceY"
        Version="0.1.0.0"
        PackageDescription="StdScout desktop app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.d3ucey.stdscout"
                Description="StdScout desktop app"
                DisplayName="StdScout"
                ExecutableName="stdscout.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>StdScout</DisplayName>
            <PublisherDisplayName>d3uceY</PublisherDisplayName>
            <Description>StdScout desktop app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="stdscout.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
